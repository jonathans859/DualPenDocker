# Copy to .env and edit. Every value here already has a working default, so
# an empty .env (or none at all) is fine.

# Which image `docker compose up` runs. Pin to a specific commit for
# reproducible deploys, e.g. ...:sha-<full commit sha>.
DUALPEN_IMAGE=ghcr.io/jonathans859/dualpendocker:latest

# Host interface and port the container is published on. Keep the interface
# on loopback unless your reverse proxy runs on a different machine.
DUALPEN_BIND=127.0.0.1
DUALPEN_PORT=8000
